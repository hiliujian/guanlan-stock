# =====================================================================
# 观澜 guanlan-stock · 环境变量样例
# ---------------------------------------------------------------------
# 复制本文件为 .env（或 .env.local），填入你在 Supabase 后台拿到的值。
# 注意：
#   · 变量名必须以 VITE_ 开头，Vite 才会在构建期静态内联进产物；
#   · .env 已被 .gitignore 忽略，请勿提交真实密钥；
#   · 填好之后，前端自动启用 Supabase 后端（登录/自选云同步/社区/公告/系统配置）。
# =====================================================================

# Supabase 项目地址，形如 https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon / public key（Project Settings → API → anon public）
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 是否通过 Supabase Edge Function 代理行情 / 资金流（默认 true）。
# 东财经 Supabase Edge Function 已验证可访问；关闭则回退直连 / JSONP / 公共代理。
VITE_USE_EDGE_FUNCTIONS=true

# 可选的行情代理服务地址（留空则前端自动回退公共代理）
VITE_API_PROXY=
